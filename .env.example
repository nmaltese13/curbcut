# Copy to .env for local development. Every value here has a safe default except
# SESSION_SECRET, which is required in production.

NODE_ENV=development
PORT=3300
HOST=127.0.0.1
APP_URL=http://localhost:3300

# SQLite file. Created automatically.
DATABASE_PATH=./data/curbcut.db

# Required in production. Generate with: openssl rand -hex 32
# SESSION_SECRET=

LOG_LEVEL=debug

# --- Billing -------------------------------------------------------------
# Without a secret key the app runs in local billing mode: plan changes apply
# immediately and no payment is taken. The product is fully usable this way.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...

# --- AI ------------------------------------------------------------------
# Optional. Enhances fix suggestions for issues needing human wording.
# Every rule and every deterministic fix works without it.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Email ---------------------------------------------------------------
# Without an API key the app records every message to the outbox, logs it, and
# prints reset/invite links to the console. Password reset and invitations are
# fully testable this way. Set a key to deliver for real.
# EMAIL_PROVIDER=resend        # resend | postmark
# EMAIL_API_KEY=re_...
# EMAIL_FROM=Curbcut <notifications@yourdomain.com>

# --- Scheduled scans ------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# --- Headless rendering ---------------------------------------------------
# auto = use a real browser when Playwright is installed, else static HTML.
RENDER_MODE=auto
RENDER_TIMEOUT_MS=20000

# --- Crawler -------------------------------------------------------------
CRAWLER_CONCURRENCY=4
CRAWLER_DELAY_MS=150
CRAWLER_TIMEOUT_MS=15000

# --- Free scan limits ----------------------------------------------------
PUBLIC_SCAN_PER_HOUR=5
